# Local secret bindings surfaced through env at runtime during `next dev` and
# `opennextjs-cloudflare preview`. Copy this file to `.dev.vars` (gitignored)
# and fill in real values. Never commit `.dev.vars` — production secrets are
# provisioned via `wrangler secret put <NAME>`.

# 32-byte key (base64) used by the AES-GCM-256 encrypt-at-rest utility to
# protect bot tokens and user auth tokens stored in D1. Also the HMAC key for
# the signed session cookie and per-bot Telegram webhook secrets.
# Generate: openssl rand -base64 32
ENCRYPTION_SECRET=

# Shared secret required by the admin-triggered cron sweep endpoint
# (POST /api/cron/scheduled-broadcasts, X-Cron-Secret header). The scheduled
# Cloudflare Cron Trigger itself does not need this — it runs inside the
# worker's scheduled() export.
# Generate: openssl rand -hex 32
CRON_SECRET=

# Public origin the app is reachable at. Telegram fetches media through this
# URL when we send photo/document broadcasts. In local dev this is your
# Cloudflare Tunnel or ngrok URL (must be HTTPS, publicly reachable). In
# production, the deployed workers.dev / custom domain.
# Example dev value: https://my-bot.trycloudflare.com
PUBLIC_APP_URL=
