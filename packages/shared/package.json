{
  "name": "@telegram-bot/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared library: DB schema, crypto, Telegram client, rate limiting, access control. Consumed by apps/web and apps/bot-api.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema/index.ts",
    "./crypto": "./src/crypto/index.ts",
    "./telegram": "./src/telegram/index.ts",
    "./telegram/webhook": "./src/telegram/webhook.ts",
    "./telegram/schemas": "./src/telegram/schemas.ts",
    "./telegram/types": "./src/telegram/types.ts",
    "./telegram/avatar": "./src/telegram/avatar.ts",
    "./access-control": "./src/access-control/index.ts",
    "./access-control/guards": "./src/access-control/guards.ts",
    "./rate-limit": "./src/rate-limit/index.ts",
    "./rate-limit/telegram": "./src/rate-limit/telegram.ts",
    "./rate-limit/token-bucket": "./src/rate-limit/token-bucket.ts",
    "./rate-limit/d1-store": "./src/rate-limit/d1-store.ts",
    "./rate-limit/anon-d1-store": "./src/rate-limit/anon-d1-store.ts",
    "./r2": "./src/r2/index.ts",
    "./r2/keys": "./src/r2/keys.ts",
    "./schemas": "./src/schemas/index.ts",
    "./schemas/auth": "./src/schemas/auth.ts",
    "./schemas/broadcast": "./src/schemas/broadcast.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250820.0",
    "typescript": "^5"
  }
}
